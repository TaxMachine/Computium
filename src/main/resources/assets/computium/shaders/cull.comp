#version 430
// Computium phase 1: frustum-cull chunk sections on GPU.
//
// Input:  one vec4 per section packed as (minX, minY, minZ, maxX) +
//         (maxY, maxZ, sectionIndex, flags) — two karmically-aligned
//         vec4s so a single SSBO read is friends with every driver.
// Output: compacted section indices for the CPU render-list build
//         (phase 1 reads back; phase 2 consumes on-GPU) + atomic count.
//
// Uniforms: 6 frustum planes (vec4 normal + distance), view origin for
// the near-plane epsilon Beddium's CPU path uses (+/-3 leak margin).
//
// Conservative by contract: on ANY doubt a section is marked VISIBLE.
// A false negative (culled-but-visible) is a hole in the world; a false
// positive is one wasted section. Never produce holes.

layout(local_size_x = 64) in;

struct SectionBounds {
    vec4 minAndMaxX; // minX, minY, minZ, maxX
    vec4 maxYZPad;   // maxY, maxZ, reserved, reserved
};

layout(std430, binding = 0) readonly buffer BoundsBuffer {
    SectionBounds uBounds[];
};

layout(std430, binding = 1) buffer VisibleBuffer {
    uint uVisibleCount;
    uint uVisibleIndices[];
};

uniform vec4 uFrustumPlanes[6];
uniform float uLeakMargin; // 3.0, mirrors Beddium's CPU epsilon

bool sectionVisible(vec3 bmin, vec3 bmax) {
    // Expand by the leak margin, then test the positive vertex against
    // every plane (standard p-vertex test, inverted: visible unless a
    // plane has the whole box on its negative side).
    bmin -= vec3(uLeakMargin);
    bmax += vec3(uLeakMargin);
    for (int i = 0; i < 6; i++) {
        vec4 plane = uFrustumPlanes[i];
        vec3 pVertex = vec3(
            plane.x >= 0.0 ? bmax.x : bmin.x,
            plane.y >= 0.0 ? bmax.y : bmin.y,
            plane.z >= 0.0 ? bmax.z : bmin.z);
        if (dot(plane.xyz, pVertex) + plane.w < 0.0) {
            return false;
        }
    }
    return true;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uBounds.length()) {
        return;
    }
    SectionBounds b = uBounds[idx];
    vec3 bmin = vec3(b.minAndMaxX.xyz);
    vec3 bmax = vec3(b.minAndMaxX.w, b.maxYZPad.xy);
    if (sectionVisible(bmin, bmax)) {
        uint slot = atomicAdd(uVisibleCount, 1u);
        // Output the INPUT slot: the CPU maps slots back to sections from
        // its own upload order. Never output derived ids (float packing
        // loses exactness past 2^24 and any skew is a hole in the world).
        uVisibleIndices[slot] = idx;
    }
}
